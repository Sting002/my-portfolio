# Copy this file to .env and fill in your EmailJS values.
# After editing .env, restart `npm run dev` so Vite picks the values up.
#
# These three are PUBLIC identifiers by design (they ship in the browser bundle).
# Never put a private key or password in any VITE_ variable.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
